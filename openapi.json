{
  "openapi": "3.1.0",
  "info": {
    "title": "Mnemosyne Memory API",
    "description": "Retrieves context from the Gemini history via Mnemosyne.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://fancy-things-tickle.loca.lt"
    }
  ],
  "paths": {
    "/search_memory": {
      "post": {
        "operationId": "searchMemory",
        "summary": "Search memory",
        "description": "Searches the ingested Gemini history for relevant context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The search query."
                  }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
